<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PomodoroTimer" parent="Theme.MaterialComponents.DayNight">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorSecondaryVariant">@color/brand</item>
        <item name="colorOnSecondary">@color/on_brand</item>
        <item name="android:statusBarColor">@color/surface_card</item>
        <item name="actionBarStyle">@style/AppActionBar</item>
        <item name="android:actionBarStyle">@style/AppActionBar</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/surface_card</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Pomodoro.MaterialAlertDialog</item>
    </style>

    <style name="Theme.PomodoroTimer.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorOnSecondary">@color/on_brand</item>
        <item name="android:statusBarColor">@color/surface_card</item>
        <item name="android:navigationBarColor">@color/surface_card</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Pomodoro.MaterialAlertDialog</item>
    </style>

    <style name="Theme.PomodoroTimer.Dark" parent="Theme.PomodoroTimer">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/surface_page</item>
    </style>
</resources>
