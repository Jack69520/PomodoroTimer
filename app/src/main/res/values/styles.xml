<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 「我的」页功能列表行 -->
    <style name="ProfileMenuRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="ProfileMenuRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="ProfileMenuRowIconWell">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:background">@drawable/bg_profile_icon_well</item>
    </style>

    <style name="ProfileMenuRowIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="ProfileMenuRowArrow">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:alpha">0.4</item>
    </style>

    <style name="ProfileMenuDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">62dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:alpha">0.65</item>
        <item name="android:background">@drawable/bg_profile_divider</item>
    </style>

    <!-- 主题色分类 Tab 文字 -->
    <style name="SettingsThemeTabText" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- 设置页：分组标题（表面外） -->
    <style name="SettingsSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- 设置页：导航行（标题 + 右侧摘要 + 箭头） -->
    <style name="SettingsNavRow" parent="ProfileMenuRow">
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="SettingsNavRowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:maxWidth">140dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- 设置页：权限行 -->
    <style name="SettingsPermissionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- 番茄设置：开关行容器 -->
    <style name="SettingsSwitchBlock">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- 番茄设置：可点击取值行 -->
    <style name="SettingsValueRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:background">@android:color/transparent</item>
    </style>


    <style name="BottomNavigationTextActive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="BottomNavigationTextInactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="AppActionBar" parent="Widget.MaterialComponents.ActionBar.Primary">
        <item name="android:background">@color/surface_card</item>
        <item name="background">@color/surface_card</item>
        <item name="android:titleTextStyle">@style/AppActionBarTitle</item>
        <item name="titleTextStyle">@style/AppActionBarTitle</item>
        <item name="elevation">4dp</item>
    </style>

    <style name="AppActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- 根页面 Toolbar：无阴影、无边框 -->
    <style name="MainToolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="background">@android:color/transparent</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:outlineProvider">none</item>
    </style>

    <!-- 首页计时双按钮：同行等宽、实心底、统一高度 -->
    <style name="HomeTimerActionButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@null</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">18dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="HomeTimerPrimaryButton" parent="HomeTimerActionButton">
        <item name="android:textColor">@color/comp_home_control_on_primary</item>
        <item name="android:background">@drawable/bg_home_control_primary</item>
        <item name="rippleColor">@color/comp_home_control_ripple</item>
        <item name="iconTint">@color/comp_home_control_on_primary</item>
    </style>

    <style name="HomeTimerSecondaryButton" parent="HomeTimerActionButton">
        <item name="android:textColor">@color/comp_home_control_on_secondary</item>
        <item name="android:background">@drawable/bg_home_control_secondary</item>
        <item name="rippleColor">@color/comp_home_control_ripple_soft</item>
        <item name="iconTint">@color/comp_home_control_on_secondary</item>
    </style>

    <style name="HomeTimerPhaseLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="HomeTimerDisplay">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">64sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">@color/comp_home_timer_display</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 账户表单输入：随 surface 层级适配深浅色 -->
    <style name="AccountFormEditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Auth 统一表单体系（登录/注册/改密/找回/设新密） -->
    <style name="AuthFormSubtitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="AuthTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_input_box_stroke</item>
        <item name="hintTextColor">@color/brand</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <style name="AuthTextInputEditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="AuthPrimaryButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/on_brand</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/brand</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/bottom_nav_ripple</item>
    </style>

    <!-- 系统 MaterialAlertDialog（列表选择等）统一圆角与品牌色 -->
    <style name="ShapeAppearance.Pomodoro.Dialog" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ThemeOverlay.Pomodoro.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Pomodoro.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Pomodoro.Dialog.Body</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Pomodoro.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Pomodoro.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Pomodoro.Dialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Pomodoro.Dialog.Button</item>
    </style>

    <style name="TextAppearance.Pomodoro.Dialog.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Pomodoro.Dialog.Body" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Widget.Pomodoro.Dialog.Button" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/brand</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/brand_container</item>
    </style>
</resources>
