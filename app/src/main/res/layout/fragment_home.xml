<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="12dp">

    <!-- 计时舞台：时间为主视觉，双按钮同行等宽 -->
    <LinearLayout
        android:id="@+id/home_timer_stage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_home_timer_stage"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <View
                android:id="@+id/timer_phase_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_home_phase_dot" />

            <TextView
                android:id="@+id/timer_phase_text"
                style="@style/HomeTimerPhaseLabel"
                android:text="@string/home_phase_idle" />
        </LinearLayout>

        <TextView
            android:id="@+id/timer_text"
            style="@style/HomeTimerDisplay"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp"
            android:text="@string/layout_placeholder_timer" />

        <TextView
            android:id="@+id/study_duration_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:letterSpacing="0.04"
            android:text="@string/home_study_duration_hint"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/control_button"
                style="@style/HomeTimerPrimaryButton"
                android:layout_marginEnd="6dp"
                android:text="@string/home_control_start"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_resume" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reset_button"
                style="@style/HomeTimerSecondaryButton"
                android:layout_marginStart="6dp"
                android:text="@string/home_reset_duration"
                app:backgroundTint="@null" />
        </LinearLayout>
    </LinearLayout>

    <!-- 筛选器：轻量可折叠 -->
    <LinearLayout
        android:id="@+id/todo_filter_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/filter_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_filter_title"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <ImageView
                android:id="@+id/filter_arrow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:rotation="90"
                android:src="@drawable/ic_arrow_right" />

            <TextView
                android:id="@+id/btn_clear_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="@string/home_filter_clear"
                android:textColor="@color/brand"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/filter_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Spinner
                android:id="@+id/priority_filter_spinner"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/spinner_background" />

            <Spinner
                android:id="@+id/due_date_filter_spinner"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/spinner_background" />

            <Spinner
                android:id="@+id/category_filter_spinner"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/spinner_background" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/todo_empty_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="48dp"
        android:paddingBottom="24dp"
        android:text="@string/todo_empty_message"
        android:textColor="@color/text_hint"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/todo_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none" />
</LinearLayout>
