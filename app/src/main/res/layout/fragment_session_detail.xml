<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/session_detail_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingHorizontal="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="24dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 基本信息 -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/session_detail_basic_info" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_settings_surface"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/status_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_session_status_completed"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/session_status_completed"
                android:textSize="12sp"
                android:textStyle="bold" />

            <include
                android:id="@+id/row_start_time"
                layout="@layout/item_session_detail_row" />

            <include
                android:id="@+id/row_end_time"
                layout="@layout/item_session_detail_row" />

            <include
                android:id="@+id/row_duration"
                layout="@layout/item_session_detail_row" />

            <include
                android:id="@+id/row_category"
                layout="@layout/item_session_detail_row" />
        </LinearLayout>

        <!-- 暂停信息 -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/session_detail_pause_info" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_settings_surface"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <include
                android:id="@+id/row_has_pause"
                layout="@layout/item_session_detail_row" />

            <include
                android:id="@+id/row_pause_count"
                layout="@layout/item_session_detail_row" />

            <include
                android:id="@+id/row_early_end"
                layout="@layout/item_session_detail_row" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/session_detail_pause_reasons_label"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pause_reasons_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/session_detail_none"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 应用拦截 -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/session_detail_block_info" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_settings_surface"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <include
                android:id="@+id/row_block_count"
                layout="@layout/item_session_detail_row" />

            <TextView
                android:id="@+id/block_encouragement_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="start"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/view_block_records_btn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/session_detail_view_block_records"
                android:textAllCaps="false"
                android:textColor="@color/brand"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                app:rippleColor="@color/bottom_nav_ripple"
                app:strokeColor="@color/brand"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- 计时心得 -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/session_detail_notes_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_surface"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/notes_input_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/session_detail_notes_hint"
                app:boxStrokeColor="@color/text_input_box_stroke"
                app:hintTextColor="@color/brand"
                app:counterEnabled="true"
                app:counterMaxLength="200"
                app:helperText="@string/session_detail_notes_helper"
                app:helperTextEnabled="true"
                app:helperTextTextColor="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/notes_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:imeOptions="actionDone"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="200"
                    android:maxLines="8"
                    android:minLines="4"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_notes_btn"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:minHeight="48dp"
            android:text="@string/session_detail_save_notes"
            android:textAllCaps="false"
            android:textColor="@color/on_brand"
            android:textSize="15sp"
            app:backgroundTint="@color/brand"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            app:rippleColor="@color/bottom_nav_ripple" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
