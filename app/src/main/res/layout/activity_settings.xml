<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/include_subpage_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/subpage_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="32dp"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 账户 -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_section_account" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_settings_surface"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <LinearLayout
                android:id="@+id/row_account_profile"
                style="@style/SettingsNavRow">

                <FrameLayout style="@style/ProfileMenuRowIconWell">

                    <ImageView
                        style="@style/ProfileMenuRowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_profile"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <TextView
                    style="@style/ProfileMenuRowText"
                    android:text="@string/title_account" />

                <ImageView
                    style="@style/ProfileMenuRowArrow"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <View style="@style/ProfileMenuDivider" />

            <LinearLayout
                android:id="@+id/row_account_security"
                style="@style/SettingsNavRow">

                <FrameLayout style="@style/ProfileMenuRowIconWell">

                    <ImageView
                        style="@style/ProfileMenuRowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <TextView
                    style="@style/ProfileMenuRowText"
                    android:text="@string/title_account_security" />

                <ImageView
                    style="@style/ProfileMenuRowArrow"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- 外观 -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_section_appearance" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_settings_surface"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <LinearLayout
                android:id="@+id/row_theme"
                style="@style/SettingsNavRow">

                <FrameLayout style="@style/ProfileMenuRowIconWell">

                    <ImageView
                        style="@style/ProfileMenuRowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_palette"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_theme_color"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/theme_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:id="@+id/theme_swatch"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_theme_swatch" />

                <ImageView
                    style="@style/ProfileMenuRowArrow"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- 声音 -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_section_sound" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_settings_surface"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <LinearLayout
                android:id="@+id/row_ringtone"
                style="@style/SettingsNavRow">

                <FrameLayout style="@style/ProfileMenuRowIconWell">

                    <ImageView
                        style="@style/ProfileMenuRowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ringtone"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <TextView
                    style="@style/ProfileMenuRowText"
                    android:text="@string/select_ringtone" />

                <TextView
                    android:id="@+id/ringtone_value"
                    style="@style/SettingsNavRowValue" />

                <ImageView
                    style="@style/ProfileMenuRowArrow"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- 番茄钟与待办 -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_section_pomodoro_task" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_settings_surface"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <LinearLayout
                android:id="@+id/row_pomodoro"
                style="@style/SettingsNavRow">

                <FrameLayout style="@style/ProfileMenuRowIconWell">

                    <ImageView
                        style="@style/ProfileMenuRowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_timer"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_pomodoro_entry_title"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/pomodoro_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    style="@style/ProfileMenuRowArrow"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- 系统 -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_section_system" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_settings_surface"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <LinearLayout
                android:id="@+id/row_system_permissions"
                style="@style/SettingsNavRow">

                <FrameLayout style="@style/ProfileMenuRowIconWell">

                    <ImageView
                        style="@style/ProfileMenuRowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_permission"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <TextView
                    style="@style/ProfileMenuRowText"
                    android:text="@string/settings_system_permissions" />

                <ImageView
                    style="@style/ProfileMenuRowArrow"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
</LinearLayout>
