<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginBottom="6dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/swipe_delete_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/common_label_delete"
        android:src="@drawable/ic_swipe_delete_trash" />

    <LinearLayout
        android:id="@+id/todo_item_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_subtask_row"
        android:minHeight="48dp">

        <CheckBox
            android:id="@+id/subtask_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/subtask_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/subtask_pomodoro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:layout_marginEnd="4dp" />

        <ImageView
            android:id="@+id/subtask_start_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_timer"
            app:tint="@color/text_secondary"
            android:contentDescription="@string/task_a11y_start_timer"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="6dp" />
    </LinearLayout>
</FrameLayout>
