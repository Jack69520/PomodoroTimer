<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingHorizontal="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="32dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 账户 Hero：无描边表面 -->
        <LinearLayout
            android:id="@+id/account_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_profile_surface"
            android:clickable="true"
            android:contentDescription="@string/profile_account_section_content_description"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="20dp">

            <ImageView
                android:id="@+id/account_avatar"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_profile_avatar"
                android:contentDescription="@string/profile_avatar_content_description"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_default_avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/account_nickname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:letterSpacing="0.01"
                    android:maxLines="1"
                    android:text="@string/profile_login_prompt"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/account_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/account_signature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:text="@string/profile_signature_placeholder"
                    android:textColor="@color/text_hint"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="10dp"
                android:alpha="0.4"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- 轻量专注摘要：双列，无描边 -->
        <LinearLayout
            android:id="@+id/stats_summary_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_profile_surface"
            android:clickable="true"
            android:contentDescription="@string/profile_stats_section_content_description"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_summary_total_caption"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/count_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:alpha="0.55"
                android:background="@drawable/bg_profile_divider" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_summary_duration_caption"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/duration_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:alpha="0.35"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- 应用屏蔽 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:background="@drawable/bg_profile_surface"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:minHeight="40dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/profile_app_blocking"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/app_blocking_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:showText="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/app_blocking_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/profile_app_blocking_description"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_app_blocking_settings"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/blocking_title_manage_apps"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:visibility="gone"
                app:backgroundTint="@color/surface_container"
                app:cornerRadius="12dp"
                app:elevation="0dp"
                app:rippleColor="@color/bottom_nav_ripple" />
        </LinearLayout>

        <!-- 功能分组列表：无描边 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_profile_surface"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <LinearLayout
                android:id="@+id/btn_settings"
                style="@style/ProfileMenuRow">

                <FrameLayout style="@style/ProfileMenuRowIconWell">

                    <ImageView
                        style="@style/ProfileMenuRowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <TextView
                    style="@style/ProfileMenuRowText"
                    android:text="@string/settings_title" />

                <ImageView
                    style="@style/ProfileMenuRowArrow"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <View
                android:id="@+id/divider_before_dev_lab"
                style="@style/ProfileMenuDivider"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/btn_dev_lab"
                style="@style/ProfileMenuRow"
                android:visibility="gone">

                <FrameLayout style="@style/ProfileMenuRowIconWell">

                    <ImageView
                        style="@style/ProfileMenuRowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_lab"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <TextView
                    style="@style/ProfileMenuRowText"
                    android:text="@string/title_dev_lab" />

                <ImageView
                    style="@style/ProfileMenuRowArrow"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <View style="@style/ProfileMenuDivider" />

            <LinearLayout
                android:id="@+id/btn_faq"
                style="@style/ProfileMenuRow">

                <FrameLayout style="@style/ProfileMenuRowIconWell">

                    <ImageView
                        style="@style/ProfileMenuRowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_faq_white"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <TextView
                    style="@style/ProfileMenuRowText"
                    android:text="@string/title_faq" />

                <ImageView
                    style="@style/ProfileMenuRowArrow"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <View style="@style/ProfileMenuDivider" />

            <LinearLayout
                android:id="@+id/btn_about"
                style="@style/ProfileMenuRow">

                <FrameLayout style="@style/ProfileMenuRowIconWell">

                    <ImageView
                        style="@style/ProfileMenuRowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_about_white"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <TextView
                    style="@style/ProfileMenuRowText"
                    android:text="@string/title_about" />

                <ImageView
                    style="@style/ProfileMenuRowArrow"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
